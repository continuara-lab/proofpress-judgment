{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Judgment Format 0.3-draft (reads 0.1/0.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ajf_version",
    "id",
    "version",
    "name",
    "description",
    "judgment",
    "applicability",
    "provenance",
    "evidence",
    "links"
  ],
  "properties": {
    "ajf_version": {
      "enum": [
        "0.1-draft",
        "0.2-draft",
        "0.3-draft"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^jgm_[a-f0-9]{32}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "$ref": "#/$defs/text"
    },
    "description": {
      "$ref": "#/$defs/text"
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "kind",
        "rationale"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "enum": [
            "conditional_guidance",
            "case",
            "hypothesis",
            "constraint"
          ]
        },
        "assertion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "value"
          ],
          "properties": {
            "key": {
              "$ref": "#/$defs/text"
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        },
        "rationale": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "polarity": {
          "enum": [
            "prefer",
            "avoid"
          ]
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "when",
        "limits"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/text"
        },
        "when": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "equals"
            ],
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
              },
              "equals": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "recorded_by",
        "recorded_at",
        "capture_method",
        "source_refs"
      ],
      "properties": {
        "origin": {
          "enum": [
            "human_guidance",
            "human_judgment",
            "agent_judgment",
            "agent_assumption",
            "unknown"
          ]
        },
        "judged_by": {
          "$ref": "#/$defs/text"
        },
        "decision_maker": {
          "$ref": "#/$defs/text"
        },
        "recorded_by": {
          "$ref": "#/$defs/text"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "capture_method": {
          "enum": [
            "explicit",
            "extracted",
            "imported"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "role"
        ],
        "properties": {
          "reference": {
            "$ref": "#/$defs/text"
          },
          "role": {
            "enum": [
              "supports",
              "challenges",
              "context"
            ]
          },
          "summary": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation",
          "id",
          "version",
          "digest"
        ],
        "properties": {
          "relation": {
            "enum": [
              "revises",
              "depends_on"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^jgm_[a-f0-9]{32}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "extensions": {
      "type": "object"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "situation"
      ],
      "properties": {
        "situation": {
          "$ref": "#/$defs/text"
        },
        "goal": {
          "$ref": "#/$defs/text"
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "facts": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option",
          "reason_not_chosen"
        ],
        "properties": {
          "option": {
            "$ref": "#/$defs/text"
          },
          "reason_not_chosen": {
            "anyOf": [
              {
                "$ref": "#/$defs/text"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    },
    "expected_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/text"
        },
        "verification": {
          "$ref": "#/$defs/text"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ajf_version": {
            "enum": [
              "0.2-draft",
              "0.3-draft"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "not": {
              "required": [
                "decision_maker"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "provenance": {
            "not": {
              "required": [
                "judged_by"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ajf_version": {
            "enum": [
              "0.1-draft",
              "0.2-draft"
            ]
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "context"
              ]
            },
            {
              "required": [
                "alternatives"
              ]
            },
            {
              "required": [
                "expected_outcome"
              ]
            },
            {
              "properties": {
                "judgment": {
                  "required": [
                    "polarity"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
