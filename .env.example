# Optional decision model assessment. Copy to .env and pass --env-file .env explicitly.
# Guidance/output selected for assessment is sent to TypeSafe. No key is needed for deterministic checks.
PROOFPRESS_DECISION_MODEL_PROVIDER=typesafe
TYPESAFE_API_KEY=
# Choose a model available to your account; pin a version for repeatable experiments.
PROOFPRESS_DECISION_MODEL=jev-1.13.0
